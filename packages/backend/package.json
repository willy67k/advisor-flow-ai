{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn app.main:app --reload --port 3801",
    "worker": "uv run celery -A app.worker:celery_app worker -l INFO --pool=solo",
    "worker:prefork": "uv run celery -A app.worker:celery_app worker -l INFO",
    "main": "uv run app/main.py",
    "install": "uv sync",
    "django:migrate": "uv run python manage.py migrate",
    "lint": "uv run ruff check .",
    "format": "uv run ruff format .",
    "test": "uv run pytest",
    "db:migrate": "uv run alembic upgrade head",
    "db:revision": "uv run alembic revision --autogenerate -m"
  }
}
