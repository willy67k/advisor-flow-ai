# Copy to `.env` in this directory (`packages/backend/.env`).
# Loaded by pydantic-settings (see app/config/env.py).
# For **`docker compose`**, copy `compose.example.env` → repo root `.env` (Compose reads that file for variable substitution) and/or pass env vars via your shell.

APP_NAME=Advisor Flow AI
APP_VERSION=0.0.1
ENVIRONMENT=development
LOG_LEVEL=INFO

# Used by Django sessions, CSRF, and **JWT signing** (`rest_framework_simplejwt` — access/refresh tokens).
DJANGO_SECRET_KEY=dev-insecure-change-me-use-a-long-random-string-in-real-deployments
DJANGO_DEBUG=true

# Comma-separated or JSON array, e.g. '["http://localhost:3800"]'
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,::1
CORS_ORIGINS='["http://localhost:3800"]'

# PostgreSQL — repo root: `docker compose up -d db` (image built from infra/docker/db).
# Omit or leave unset to keep Django on SQLite locally (not supported for pytest: tests use Postgres + pgvector).
DATABASE_URL=postgresql://advisorflow:advisorflow@127.0.0.1:5432/advisorflow

# Override pytest DB (`DJANGO_SETTINGS_MODULE=app.config.settings.test`); defaults to DATABASE_URL-compatible local compose.
TEST_DATABASE_URL=postgresql://advisorflow:advisorflow@127.0.0.1:5432/advisorflow

# Celery + Redis (`docker compose up -d redis` at repo root).
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Dev (app.config.settings.dev): when true, Celery runs tasks in-process — `yarn dev` works without `yarn worker`.
# Set to false to use the Redis queue; then start Redis and `yarn workspace backend worker`.
# For `docker compose up` (backend + worker services), set `CELERY_TASK_ALWAYS_EAGER=false` so tasks run in the worker container —
# do this in `packages/backend/.env` or duplicate keys in repo root `compose.example.env` → `.env` (Phase 9).
CELERY_TASK_ALWAYS_EAGER=true

# LangGraph checkpoints (human-in-the-loop). Default file: `<backend>/langgraph_checkpoints.sqlite3`.
# In Compose, backend + worker mount a shared volume; set explicitly in `docker-compose.yml` (see compose file / `compose.example.env`).
#LANGGRAPH_CHECKPOINT_SQLITE_PATH=

# LLM gateway (Step 3.1) — optional locally; required when calling ``complete_chat``.
OPENAI_API_KEY=
# Embeddings (Step 5.2) — same key; defaults to ``text-embedding-3-small`` (1536-dim).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Alias for Gemini Developer API key (same as GOOGLE_API_KEY in pydantic-settings).
GEMINI_API_KEY=
AI_OPENAI_DEFAULT_MODEL=gpt-4o-mini
AI_ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-20241022
AI_GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Optional: small model id only for chat relevance gate (IN_SCOPE / OFF_TOPIC). Leave unset for provider defaults (e.g. gpt-4o-mini on OpenAI).
# AI_CHAT_SCOPE_MODEL=gpt-4o-mini

# LangSmith / LangChain tracing — optional; leave empty to disable tracing.
# Use LANGSMITH_API_KEY or LANGCHAIN_API_KEY (same value). Key must allow ingest (workspace Settings → API Keys).
# HTTP 403 on …/runs/multipart: invalid/expired key, wrong LangSmith region, or org policy blocking API writes.
# EU-hosted LangSmith: LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=advisor-flow-ai
LANGCHAIN_ENDPOINT=

# Mirror stderr structlog events to Postgres (`observability_observabilitylog`). Disabled in pytest.
OBSERVABILITY_LOG_TO_DB=true
