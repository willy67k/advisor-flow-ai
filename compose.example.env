# Copy to `.env` in the repo root (same folder as `docker-compose.yml`) so
# `docker compose` substitutes variables below. Compose does not automatically
# load `packages/backend/.env` — duplicate API keys here or export them in your shell.
#
# See also: `packages/backend/.env.example` (Django / Celery defaults for local Yarn dev).

# --- Postgres / Redis published ports ---
POSTGRES_DB=advisorflow
POSTGRES_USER=advisorflow
POSTGRES_PASSWORD=advisorflow
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Published app ports ---
BACKEND_PORT=3801
FRONTEND_PORT=3800
FLOWER_PORT=5555

# --- Django ---
DJANGO_DEBUG=true
# Must match JWT signing (`djangorestframework-simplejwt` uses Django's SECRET_KEY).
DJANGO_SECRET_KEY=change-me-for-docker-compose

# --- Celery Flower: `docker compose --profile flower up` (optional) ---

# --- LLM / observability (optional; required for OCR / embeddings / chat) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Optional — cheap model for chat relevance gate only (IN_SCOPE / OFF_TOPIC).
# AI_CHAT_SCOPE_MODEL=gpt-4o-mini
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=advisor-flow-ai
# Optional — only when using EU-hosted LangSmith or a custom API base (alias: LANGSMITH_ENDPOINT in app config).
#LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
OBSERVABILITY_LOG_TO_DB=true

# Frontend dev proxy target inside Compose (defaults to backend service hostname).
VITE_DEV_PROXY_TARGET=http://backend:3801
